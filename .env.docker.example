# HaitiViral on your own server (Docker). Copy to ".env" next to docker-compose.yml and fill in.
# Never share this file or paste it in a chat. Make each secret with:  openssl rand -base64 32

# Your domain, without https:// (point its DNS "A" record to the server's IP first)
DOMAIN=haitiviral.com

# Database password (any long random text; only used inside the server)
POSTGRES_PASSWORD=

# Three secrets (all different). Keep ENCRYPTION_KEY in a password manager and never change it.
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# ── Optional: add when you're ready (empty = off) ──
# Email (Resend): password resets and confirmations
RESEND_API_KEY=
EMAIL_FROM=HaitiViral <noreply@haitiviral.com>
# MonCash business API
MONCASH_MODE=sandbox
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
# Free trial: VPN check (proxycheck.io) and WhatsApp code (Meta)
PROXYCHECK_API_KEY=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Anti-robot check (Cloudflare Turnstile). The site key is built into the pages:
# after setting it, rebuild with:  docker compose up -d --build
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Error reports (Sentry)
SENTRY_DSN=
